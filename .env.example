# Copy to .env.local and fill in. Never commit real values.
CONTEXT_DEV_API_KEY=
TAVILY_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# openrouter | anthropic
LLM_PROVIDER=openrouter
# Needs tool calling + structured outputs and fast output. Benchmarked default: minimax/minimax-m3.1-flash
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: salt for hashing client IPs in rate-limit keys
IP_HASH_SALT=
# Public URL of the deployed site (used for share/OG links), e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
