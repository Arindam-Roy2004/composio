# Copy to .env.local and fill in. Never commit real values.
CONTEXT_DEV_API_KEY=
TAVILY_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# openrouter | anthropic
LLM_PROVIDER=openrouter
# e.g. anthropic/claude-sonnet-4.5 (OpenRouter) or claude-sonnet-4-5 (Anthropic)
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: salt for hashing client IPs in rate-limit keys
IP_HASH_SALT=
